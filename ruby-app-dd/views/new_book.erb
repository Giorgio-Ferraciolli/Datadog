<a href="/" class="back-link">← Voltar</a>

<section class="page-head">
  <h1>Novo livro</h1>
</section>

<% if errors.any? %>
  <div class="alert alert-error">
    <ul>
      <% errors.each do |e| %><li><%= h(e) %></li><% end %>
    </ul>
  </div>
<% end %>

<form action="/books" method="post" class="book-form">
  <div class="form-field">
    <label for="title">Título *</label>
    <input type="text" id="title" name="title" value="<%= h(book[:title]) %>" required>
  </div>

  <div class="form-field">
    <label for="author">Autor *</label>
    <input type="text" id="author" name="author" value="<%= h(book[:author]) %>" required>
  </div>

  <div class="form-row">
    <div class="form-field">
      <label for="genre">Gênero</label>
      <input type="text" id="genre" name="genre" value="<%= h(book[:genre]) %>" placeholder="Romance, Ficção, etc.">
    </div>
    <div class="form-field">
      <label for="total_pages">Total de páginas</label>
      <input type="number" id="total_pages" name="total_pages" min="1" value="<%= book[:total_pages] %>">
    </div>
  </div>

  <div class="form-field">
    <label for="status">Status *</label>
    <select id="status" name="status">
      <option value="to_read"  <%= book[:status] == 'to_read'  ? 'selected' : '' %>>A ler</option>
      <option value="reading"  <%= book[:status] == 'reading'  ? 'selected' : '' %>>Lendo</option>
      <option value="finished" <%= book[:status] == 'finished' ? 'selected' : '' %>>Finalizado</option>
    </select>
  </div>

  <div class="form-field">
    <label for="notes">Notas</label>
    <textarea id="notes" name="notes" rows="4" placeholder="Por que você quer ler? Quem recomendou?"><%= h(book[:notes]) %></textarea>
  </div>

  <div class="form-actions">
    <a href="/" class="btn btn-ghost">Cancelar</a>
    <button type="submit" class="btn btn-primary">Salvar livro</button>
  </div>
</form>
