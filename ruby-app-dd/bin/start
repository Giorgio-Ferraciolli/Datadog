#!/usr/bin/env bash
set -e

echo "⏳ Aguardando PostgreSQL..."
until pg_isready -h db -U postgres -q; do
  sleep 1
done

echo "🗂  Rodando migrações..."
bundle exec ruby db/migrate.rb

echo "🌱 Populando dados (apenas se necessário)..."
bundle exec ruby db/seed.rb

echo "🚀 Iniciando aplicação em http://localhost:4567"
exec bundle exec puma -b tcp://0.0.0.0:4567 config.ru
