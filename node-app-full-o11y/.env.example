# ============================================================================
# Datadog credentials
# ============================================================================
# Required. Get yours from https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=replace_me_with_your_real_api_key

# Datadog site. Common values:
#   datadoghq.com      (US1, default)
#   us3.datadoghq.com  (US3)
#   us5.datadoghq.com  (US5)
#   datadoghq.eu       (EU1)
#   ap1.datadoghq.com  (AP1)
DD_SITE=datadoghq.com

# ============================================================================
# Unified service tagging — applied to traces, metrics and logs
# ============================================================================
DD_SERVICE=datadog-node-app
DD_ENV=development
DD_VERSION=1.0.0

# ============================================================================
# Agent connectivity (defaults already match docker-compose; override only if
# you run the agent somewhere else).
# ============================================================================
DD_AGENT_HOST=datadog-agent
DD_HOSTNAME=datadog-node-app-host
